{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
  "source": "~/.config/fastfetch/cat.txt",
  "padding": {
    "top": 0,
    "right": 1
  },
  "color": {
    "1": "#63aaaa",
    "2": "#63a7a7"
  }
},
  "display": {
    "key": {
      "width": 8
    },
    "color": {
      "keys": "#aaaaaa",
      "output": "37",
      "title": "#a7a7a7"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#35}{user-name}{#37}@{#35}{host-name}"
    },
    "separator",
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "command",
      "key": " GPU",
      "text": "nvidia-smi --query-gpu=name --format=csv,noheader | sed 's/ Lite Hash Rate//'"
    }
  ]
}
